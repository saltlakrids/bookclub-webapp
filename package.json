{
  "name": "bookclub-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "server": "node --disable-warning=ExperimentalWarning server/index.js",
    "server:dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "import:excel": "node --disable-warning=ExperimentalWarning server/scripts/import-excel.js"
  },
  "dependencies": {
    "@fireworks-js/vue": "^2.10.7",
    "axios": "^1.5.1",
    "vue": "^3.3.4",
    "vue-router": "^4.0.3"
  },
  "devDependencies": {
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "exceljs": "^4.4.0",
    "firebase": "^9.23.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2020
    },
    "rules": {},
    "ignorePatterns": [
      "server/"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
